MONGO_URI= # Set up a Mongo DB and put the connection uri here
STAFF_PASSWORD= # Used for emulating player accounts
LOCAL_DEV_MODE= # 0 or 1
PUBLIC_URL= # Optional: public base URL, e.g. https://zoomumba.example.com (default: taken from the request)
ASSETS_URL= # Optional: base URL for static assets (default: PUBLIC_URL)
TRUST_PROXY= # Optional: 1 = trust X-Forwarded-Proto/-Host from a reverse proxy (default: 1 unless LOCAL_DEV_MODE=1)
